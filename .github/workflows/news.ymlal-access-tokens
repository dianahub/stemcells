name: Refresh news feed
on:
  schedule:
    - cron: "17 6,18 * * *"
  workflow_dispatch: {}
permissions:
  contents: write
concurrency:
  group: refresh-news
  cancel-in-progress: false
jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Fetch ScienceDaily stem cell feed
        run: node scripts/fetch-news.mjs
      - name: Commit if changed
        run: |
          if git diff --quiet -- news.json; then echo "No change."; exit 0; fi
          git config user.name "news-feed-bot"
          git config user.email "actions@users.noreply.github.com"
          git add news.json
          git commit -m "Refresh news feed"
          git push
